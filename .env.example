# Jellyfin connection
JELLYFIN_URL=http://192.168.0.7:8096
JELLYFIN_API_KEY=

# Optional Google Sheets integration
SHEET_ID=

# Host port published by Docker Compose
JELLYFIN_CAPTURE_PORT=4301

# Container user; change to the host's `id -u` / `id -g` if needed for mounted files
JELLYFIN_CAPTURE_UID=1000
JELLYFIN_CAPTURE_GID=1000

# Optional local Docker testing override. Production defaults to /mnt/nfs on the host.
# MEDIA_HOST_PATH=./testData/mnt/nfs

# Optional when running the API directly on the Mac; maps /mnt/nfs under testData.
# MEDIA_BASE_PATH=/absolute/path/to/video-clips/testData
